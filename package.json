{
  "name": "miracle",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "aramid",
    "back",
    "back-nest",
    "front",
    "tools",
    "types"
  ],
  "scripts": {
    "refresh": "npm run install:all && npm run build:aramid && npm run build:types && npm run build:back && npm run generate:all",
    "install:all": "npm install --workspaces --include-workspace-root",
    
    "build:aramid": "npm run build --workspace=aramid",
    "build:types": "npm run build --workspace=types",
    "build:back": "npm run build:types && npm run build --workspace=back-nest",

    "launch:full": "concurrently --kill-others --names \"BACK,FRONT\" -c \"blue,green\" \"npm run launch:back\" \"npm run launch:front\"",
    "launch:back": "npm run dev --workspace=back-nest",
    "launch:front": "npm run dev --workspace=front",

    "generate:all": "npm run generate:client-nest --workspace=tools",
    "generate-client": "npm run generate:client-nest --workspace=tools",

    "deploy": "tsx tools/src/deploy/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
