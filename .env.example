# Miracle — пример конфигурации окружения
# Скопируйте в `.env` в корне монорепозитория и подставьте свои значения.
# Файл читают: back-nest (load-env + Nest ConfigModule), front (Vite), deploy (npm run deploy).

# ── Общее ──────────────────────────────────────────────────────────────────────

# development | production
# production включает secure-флаг для auth-cookies
NODE_ENV=development

# Уровень логов winston: error | warn | info | http
LOG_LEVEL=info

# ── Backend (back-nest) ──────────────────────────────────────────────────────

# HTTP-порт API
PORT=3001

# CORS: true — разрешить любой origin (удобно в dev)
# false — только origins из CORS_ORIGIN
CORS_OPEN=false

# Разрешённые origins через запятую (если CORS_OPEN=false)
CORS_ORIGIN=http://localhost:8081

# JWT / cookies (формат lifetime — библиотека ms: 15m, 7d, 1h, …)
ACCESS_TOKEN_LIFETIME=15m
REFRESH_TOKEN_LIFETIME=7d

# Секреты подписи токенов. В production — случайные строки 32+ символа!
ACCESS_TOKEN_SECRET=access_token_secret
REFRESH_TOKEN_SECRET=refresh_token_secret

# ── PostgreSQL (Docker) ──────────────────────────────────────────────────────
# Учётные данные контейнера Postgres (docker-compose.yml читает их отсюда же).
POSTGRES_USER=miracle
POSTGRES_PASSWORD=miracle
POSTGRES_DB=miracle
POSTGRES_HOST_PORT=5432

# Строка подключения для Prisma CLI и runtime-адаптера.
# Хост — localhost, т.к. NestJS запускается вне Docker, порт проброшен наружу.
DATABASE_URL=postgresql://miracle:miracle@localhost:5432/miracle?schema=public

# Директория для загружаемых файлов (относительно back-nest/ или абсолютный путь).
# По умолчанию — back-nest/uploads/
UPLOADS_DIR=./data/uploads

# ── Frontend (Vite) ──────────────────────────────────────────────────────────

# Порт dev/preview-сервера фронта
VITE_PORT=8081

# Базовый URL API для axios (withCredentials: true)
VITE_API_URL=http://localhost:3001

# ── Document Prepare Service (kreuzberg) ─────────────────────────────────────
# REST-сервис извлечения markdown для non-vision форматов (Docker: сервис kreuzberg).
# Базовый URL для HTTP-адаптера back-nest (хост — localhost, порт проброшен наружу).
KREUZBERG_URL=http://localhost:8000
# Порт публикации контейнera kreuzberg на хосте (docker-compose.yml).
KREUZBERG_HOST_PORT=8000
# Лимит одновременных HTTP-запросов к kreuzberg (используется в Фазе 2+).
DPS_MAX_CONCURRENCY=4

# ── LibreOffice DOC→DOCX converter (Docker) ──────────────────────────────────
# Сервис конвертации legacy .doc → .docx перед Kreuzberg (см. data-prepare-services/libreoffice).
# Базовый URL для HTTP-адаптера back-nest (хост — localhost, порт проброшен наружу).
LIBREOFFICE_CONVERT_URL=http://localhost:2004
# Порт публикации контейнера конвертера на хосте (docker-compose.yml).
LIBREOFFICE_CONVERT_HOST_PORT=2004
# Лимит одновременных конвертаций .doc → .docx (unoserver — один файл за раз; поднимать только
# при нескольких репликах конвертера).
LIBREOFFICE_CONVERT_MAX_CONCURRENCY=1

# ── Yandex Cloud (опционально) ───────────────────────────────────────────────
# Авторизованный ключ сервис-аккаунта (IAM). Без него back-nest стартует; Job с OCR/LLM/Vision и
# виджет баланса упадут при первом вызове. Поля — из скачанного authorized_key.json:
#   YANDEX_CLOUD_IAM_ID          ← "id"                  (идентификатор ключа)
#   YANDEX_CLOUD_IAM_SERVICE_ID  ← "service_account_id"  (идентификатор сервис-аккаунта)
#   YANDEX_CLOUD_IAM_PRIVATE_KEY ← "private_key"         (PEM одной строкой с \n; преамбула
#                                                        PLEASE DO NOT REMOVE… допустима — jose её срежет)
YANDEX_CLOUD_IAM_ID=
YANDEX_CLOUD_IAM_SERVICE_ID=
YANDEX_CLOUD_IAM_PRIVATE_KEY=
YANDEX_CLOUD_FOLDER_ID=
# ID биллинг-аккаунта для виджета баланса. Если пусто — берётся первый доступный аккаунт.
YANDEX_CLOUD_BILLING_ACCOUNT_ID=

# Включить LLM Vision-разметку VISUAL-файлов (Yandex). По умолчанию выкл: vision-джоба помечает
# запрос ошибкой, автоматическая разметка не идёт. Для включения — LLM_VISION_ENABLED=true.
LLM_VISION_ENABLED=false
