{
  "font": {
    "family": {
      "sans": { "$value": "'Roboto', 'IBM Plex Sans', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'IBM Plex Mono', 'Roboto Mono', monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs":  { "$value": "12px", "$type": "dimension" },
      "sm":  { "$value": "14px", "$type": "dimension" },
      "md":  { "$value": "16px", "$type": "dimension" },
      "lg":  { "$value": "18px", "$type": "dimension" },
      "xl":  { "$value": "20px", "$type": "dimension" },
      "2xl": { "$value": "24px", "$type": "dimension" },
      "3xl": { "$value": "28px", "$type": "dimension" },
      "4xl": { "$value": "32px", "$type": "dimension" },
      "5xl": { "$value": "36px", "$type": "dimension" },
      "6xl": { "$value": "42px", "$type": "dimension" },
      "7xl": { "$value": "54px", "$type": "dimension" }
    },
    "weight": {
      "light":   { "$value": "300", "$type": "fontWeight" },
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "semibold":{ "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "$value": "1.2", "$type": "number" },
      "snug":    { "$value": "1.3", "$type": "number" },
      "normal":  { "$value": "1.5", "$type": "number" },
      "relaxed": { "$value": "1.625", "$type": "number" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.01em", "$type": "dimension" },
      "normal": { "$value": "0",       "$type": "dimension" },
      "wide":   { "$value": "0.08em",  "$type": "dimension" }
    }
  }
}
