{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "front:dev",
      "type": "shell",
      "command": "npm run launch:front",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "label": "Front Dev Server"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
