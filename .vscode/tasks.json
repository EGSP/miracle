{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "back:build",
      "type": "shell",
      "command": "npm run build --workspace=back",
      "group": "build",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "label": "Back Build"
      }
    },
    {
      "label": "back:dev",
      "type": "shell",
      "command": "npm run dev:debug --workspace=back",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "label": "Back Dev Server"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "tsx",
          "endsPattern": "\\[VSCode Hook\\] Attach Debugger"
        }
      }
    },
    {
      "label": "front:dev",
      "type": "shell",
      "command": "node ../node_modules/vite/bin/vite.js",
      "options": {
        "cwd": "${workspaceFolder}/front"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "label": "Front Dev Server"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
