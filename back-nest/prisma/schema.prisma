generator client {
  provider              = "prisma-client"
  output                = "../src/generated/prisma"
  moduleFormat          = "esm"
  generatedFileExtension = "ts"
  importFileExtension   = "js"
  runtime               = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ── Перечисления ──────────────────────────────────────────────────────────────

enum UserRole {
  EMPLOYEE
  ADMIN
}

enum JobStatus {
  queued
  running
  succeed
  // Частичный успех веера: часть детей упала, часть прошла (только для оркестраторов).
  partial
  failed
  cancelled
}

// ── Модели ────────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  login     String
  role      UserRole
  // Хранится только на бэкенде; никогда не возвращается клиенту.
  password  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  accessToken  String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model ProductType {
  id        String    @id @default(uuid())
  name      String
  // string[] — хранится как jsonb для единообразия с остальными вложенными структурами
  synonyms  Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("product_types")
}

model File {
  id        String    @id @default(uuid())
  name      String
  extension String
  bytes     Int
  pages     Int?
  authorId  String
  // FileModel.settings — { complexLayout?, isTechnicalCondition?, usedPages? }
  settings  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("files")
}

// К одному файлу может быть несколько записей контента (разные попытки извлечения).
model FileContent {
  id      String  @id @default(uuid())
  fileId  String
  // Content[] — массив { page?, text? }
  content Json?
  // { extractionType?, extractionStatus?, extractionFailedMessage? }
  meta    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([fileId])
  @@map("file_contents")
}

model Order {
  id       String  @id @default(uuid())
  authorId String
  name     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("orders")
}

// Приложение к заказу. К одному заказу может быть несколько приложений (несколько источников),
// все равноправны. Полезная нагрузка — дискриминированный юнион ApplicationData (file | text).
model OrderApplication {
  id       String @id @default(uuid())
  orderId  String
  authorId String
  // ApplicationData — { type:'file', fileId } | { type:'text', text }
  data     Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@map("order_applications")
}

// Позиция в приложении заказа. Одно приложение → несколько позиций.
// Результат обработки источника. Связь плоская (applicationId + @@index), как везде в схеме.
model OrderPosition {
  id              String  @id @default(uuid())
  applicationId   String
  name            String
  productTypeId   String?
  productTypeName String?
  data            Json // OrderPositionData

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([applicationId])
  @@map("order_positions")
}

// Условное обозначение позиции (результат analyse-designation). 1:1 с позицией.
// Связь плоская через orderPositionId (уникален), как везде в схеме.
model Designation {
  id              String @id @default(uuid())
  orderPositionId String @unique
  tcId            String
  values          Json? // DesignationValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("designations")
}

model TechnicalCondition {
  id                  String  @id @default(uuid())
  name                String?
  fileId              String?
  productTypeId       String?
  lastProductTypeName String?
  // SlotRule[]
  slotRules           Json?
  // DisplayTemplate[]
  displayTemplates    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("technical_conditions")
}

// Прогоны durable-движка задач (JobRun). Плоские: дерево выражается ссылкой parentId,
// идентичность/дедупликация — глобально по keyHash (хеш ключа-массива key). parentId — навигация.
model JobRun {
  id       String    @id @default(uuid())
  job      String
  parentId String?
  key      Json?
  keyHash  String
  status   JobStatus
  input    Json?
  output   Json?
  error    String?
  progress Json?
  memo     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyHash])
  @@index([parentId])
  @@index([status])
  @@map("job_runs")
}
