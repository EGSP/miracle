{
  "name": "@miracle/back-nest",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug 9230 --watch",
    "build": "tsc",
    "start": "node dist/main.js",

    "db:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:reset-hard": "docker compose -f ../docker-compose.yml down -v",

    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:push": "dotenv -e ../.env -- prisma db push",
    "prisma:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "prisma:seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "prisma:import-product-types": "dotenv -e ../.env -- tsx prisma/import-product-types.ts",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "dotenv -e ../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@miracle/types": "^1.0.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@yandex-cloud/nodejs-sdk": "^3.2.0",
    "argon2": "^0.44.0",
    "canvas": "^3.2.3",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "lowdb": "^7.0.1",
    "mammoth": "^1.12.0",
    "ms": "^2.1.3",
    "nestjs-zod": "^5.4.0",
    "openai": "^6.39.1",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-deepmerge": "^8.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
